# Environment & Server
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./portfolio.db

# URLs & CORS
FRONTEND_URLS=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
PUBLIC_ADMIN_URL=http://localhost:5173/admin

# Security & Sessions
SECRET_KEY=
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Storage
STORAGE_BACKEND=local
MEDIA_DIR=./media
CLOUDINARY_URL=

# Deploy Hook (Vercel)
VERCEL_DEPLOY_HOOK_URL=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# AI & Kirby Assistant
KIRBY_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
EMBEDDINGS_PROVIDER=hf
HUGGINGFACE_API_TOKEN=
HF_EMBEDDINGS_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
KB_MIN_SCORE=0.35

# SMTP Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFY_EMAIL=

# Data Retention (Days)
ANALYTICS_RETENTION_DAYS=395
CHAT_RETENTION_DAYS=365

# Background jobs at startup (Kirby warm-up, retention purge). Keep true outside tests.
BACKGROUND_TASKS=true
